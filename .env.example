# Copy to .env and adjust. .env is gitignored; never commit real secrets.
# Environment variables set outside this file take precedence.

# --- Database (required) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/backendlab?sslmode=disable

# --- API server ---
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes
CORS_ALLOWED_ORIGINS=http://localhost:3000
PORT=8080

# --- Storage mode ---
# multi_instance requires postgres stores. memory is only allowed for single_instance or dev.
DEPLOYMENT_MODE=multi_instance
RATELIMIT_STORE=postgres
QUEUE_STORE=postgres
SECRET_PROVIDER=env

# --- Bootstrap admin (used only by: go run ./cmd/migrate bootstrap-admin --email=...) ---
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# --- AI provider ---
# Provider rows live in ai_provider_settings. Credentials come from env using the
# uppercased provider name as prefix, e.g. PRIMARY_BASE_URL / PRIMARY_API_KEY.
PRIMARY_BASE_URL=https://api.example.com/v1
PRIMARY_API_KEY=replace-with-provider-api-key
